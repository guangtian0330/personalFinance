{
  "name": "finpath",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "pnpm build:contracts && pnpm --parallel --filter @finpath/api --filter @finpath/web run dev",
    "dev:api": "pnpm build:contracts && pnpm --filter @finpath/api dev",
    "dev:web": "pnpm build:contracts && pnpm --filter @finpath/web dev",
    "build:contracts": "tsc --build packages/contracts",
    "build": "tsc --build && pnpm --filter @finpath/web build",
    "typecheck": "tsc --build",
    "test": "pnpm run build && pnpm test:regression && pnpm test:unit && pnpm test:harness",
    "test:regression": "node --test tests/M00-01.workspace.test.mjs apps/api/tests/M00-02.health.test.mjs apps/web/tests/M00-02.api-health.test.mjs packages/contracts/tests/M00-03.contracts.test.mjs apps/api/tests/M00-03.errors.test.mjs apps/web/tests/M00-03.client.test.mjs apps/api/tests/M00-04.auth.test.mjs apps/api/tests/M00-04.startup.test.mjs",
    "test:unit": "vitest run",
    "test:harness": "node --test tests/M00-05.harness.test.mjs",
    "test:e2e": "pnpm run build && playwright test",
    "lint": "biome lint --error-on-warnings .",
    "format:check": "biome format .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
